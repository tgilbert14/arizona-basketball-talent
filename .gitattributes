# Keep deploy-manifest checksums identical across Windows and Linux checkouts.
*.R text eol=lf
*.css text eol=lf
*.js text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Runtime data and image assets must never receive line-ending conversion.
*.db -text
*.png -text
*.rds -text
